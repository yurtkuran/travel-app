[Unit]
Description=TravelTrove coordinated off-host backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/traveltrove/current
ExecStart=/opt/traveltrove/current/deploy/backup.sh /etc/traveltrove/production.env
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true

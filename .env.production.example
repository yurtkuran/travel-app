COMPOSE_PROJECT_NAME=traveltrove-production
TRAVELTROVE_DOMAIN=travel.example.com
ACME_EMAIL=operations@example.com
TRAVELTROVE_DATA_ROOT=/srv/traveltrove

POSTGRES_DB=traveltrove
POSTGRES_USER=traveltrove
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://traveltrove:replace-with-a-url-encoded-database-password@db:5432/traveltrove

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LOG_LEVEL=info
